im214":{"night":true,"fireworks":true,"aloisBed":true,"thermos":"arms"},"heim_raum":{"three":true,"night":false}},"seen":{"ask:(Antworten: „Bin da.“)":1,"zob:hsMk":1,"ask:Worauf warten Sie?":1,"zob:hsTr1":1,"ask:Feierabend, Herr Kirchmaier.":1,"ask:Ihre Schicht ist vorbei.":1,"zob:hsTr2":1,"ask:Wer darf Sie denn ablösen?":1,"zob:wsHello":1,"ask:Kannten Sie einen Hansi? Er hat hier Fahrkarten verkauft. Am Pfeiler.":1,"ask:Würden Sie etwas für mich sagen? Zu dem Pfeiler da drüben.":1,"ask:Er hat gesagt: Servus, Burschi.":1,"jhaus:jhArr":1,"jhaus:jhCat":1,"jhaus:hbHello":1,"ask:Ana schreibt, Sie haben den Schlüssel.":1,"ask:Wie heißt Ihre Katze?":1,"dlg:hb4":1,"ask:Arbeitet meine Mutter über die Feiertage?":1,"dlg:hb1":1,"jwohnung:jwArr":1,"ask:Ich war nie fertig. Samstags.":1,"jwohnung:jwBedIn":1,"jschlaf:jsIn":1,"ask:(Nadas Dose geben.)":1,"ask:Ich muss dir etwas erzählen. Von Lana.":1,"ask:(Mala fragen.)":1,"ask:Ich habe Lana gefunden.":1,"ask:Mama. Wegen der Probe.":1,"ask:Hvala. Ali Nova godina je tek za sedam dana.":1,"ask:Wie geht es mit dem Bosnisch?":1,"dlg:tb1":1,"ask:Na zdravlje.":1,"ask:In München sind sie ungeduldig.":1,"ask:Seine Größe.":1,"ask:Nur müde.":1,"ask:Auf den Bus nach Sarajevo. Seit zweiundneunzig. Sie steigt nur nie ein.":1,"ask:Sie will keinen. Du hast sie gehört. „Nicht heute.“":1,"ask:Was siehst du?":1,"ask:Wer ist da noch wach?":1,"ask:Du bist es nicht.":1,"wiesn:wnArr":1,"wiesn:wnHello":1,"ask:Zeigst du mir das Foto? Von Papa und dem Auto.":1,"ask:Lana hat dir eine Straßenbahn gemalt.":1,"ask:Ich weiß es eben.":1,"ask:Ich muss dir etwas sagen. Über Lana.":1,"ask:Lana ist tot. Seit Januar vierundneunzig.":1,"ask:(Schweigen.)":1,"k4.m.alone1":1,"gleis11:g11first":1,"ask:Wie heißen Sie weiter? Il cognome?":1,"dlg:sp1":1,"gleis11:kiHello":1,"ask:Kannten Sie einen alten Gepäckträger? Mütze, Nummer siebzehn.":1,"ask:Kennen Sie einen Peppino?":1,"ask:Was war früher unter dem Gleis?":1,"bmission:bmFirst":1,"bmission:wiHello":1,"ask:Ich bin Übersetzer. Italienisch, unter anderem.":1,"ask:Woher kam er?":1,"barsport:bsFirst":1,"barsport:enHello":1,"ask:Kennen Sie einen Peppino? Gepäckträger, Nummer siebzehn.":1,"ask:Er ist tot.":1,"k4.g.heim1":1,"k4.g.flur1":1,"ask:Du hast heute dein Brot vergessen.":1,"dlg:dzBr":1,"ask:Erzähl mir von Baka.":1,"ask:Was hat Baka dir damals geschrieben? Dreiundneunzig.":1,"ask:Mama …":1,"jschlaf:gJsN":1,"ask:(Lesen.)":1,"ask:Ana hat eine Probe gegeben?":1,"ask:Das ist er.":1,"ask:Meine Großmutter hat damals geschrieben: nije se vratio.":1,"ana:anD2":1,"ask:Ana. Zweitausendvier.":1,"ask:Warum nicht?":1,"ask:Gut. Nach Neujahr.":1,"friedamt:faFirst":1,"friedamt:obHello":1,"ask:Es geht um den Gepäckträger. Den Sepp, von der Bahnhofsmission.":1,"ask:Was passiert jetzt mit ihm?":1,"bunker:bkFirst":1,"ask:Darf ich einen von den Zetteln mitnehmen?":1,"ask:Giuseppe Ruggiero.":1,"ask:(Den ältesten lesen.)":1,"ask:(Den letzten lesen, vom November.)":1,"ask:(Den kurzen lesen, mit der zittrigen Schrift.)":1,"ask:(Bis drei warten.)":1,"k4.g.downUp":1,"k4.g.calmSoon":1,"ask:Erzähl weiter.":1,"ask:Und die Abfahrt? In Sarajevo?":1,"ask:Hast du ihn je suchen lassen? Beim Suchdienst?":1,"ask:Danke, dass du am Donnerstag mitkommst.":1,"dlg:tjDo":1,"k4.w3ana":1,"ask:Bei meiner Mutter. Über die Feiertage.":1,"ask:Ich bin kein Gärtner, Lena.":1,"ask:Er schläft nur.":1,"dlg:lb2":1,"ask:Wir rufen Jela an.":1,"ask:„Sie sagt, du hast es gut gemeint.“":1,"ask:Vielleicht an Silvester.":1,"ask:Ich rufe Carmela an. Hier. Hören Sie zu.":1,"ask:„Ich habe seine Briefe gelesen. Und Ihre.“":1,"ask:„Seit neunzehnhundertneunundsiebzig?“":1,"ask:„Er ist tot. Am sechzehnten Dezember.“":1,"ask:„Er hört zu.“":1,"ask:(Ihre Hand nehmen.)":1,"ask:(Den Koffer tragen.)":1,"ask:Ich habe seine Schwester angerufen.":1,"ask:Am Donnerstag verabschieden wir ihn.":1,"ask:Seine Schwester will ihn heimholen.":1,"ask:Können Sie den Gong abstellen?":1,"ask:Herr Lechner erschrickt jedes Mal.":1,"k4.g.z214M":1,"k4.g.flurM1":1,"ask:Sie haben immer draußen gewartet. Am Depot.":1,"k4.g.raum1":1,"ask:(Ihr sagen, was die Versuche gezeigt haben.)":1,"ask:(Die Versuche erzählen.)":1,"ask:„Hat er früher gefroren, wenn Sie da waren?“":1,"gleis11:g11d4":1,"ask:(Mit seinem Namen anfangen.)":1,"ask:(Neben sie treten.)":1,"ask:„Endstation, Herr Lechner. Feierabend. Die Gerda wartet am Depot, mit der Kanne.“":1,"ask:Was sehen Sie im Licht?":1,"dlg:h4lg2":1,"ask:(Ihr die Stufe hinaufhelfen.)":1,"ask:Woher weißt du das?":1,"ask:Du hast in meinem Leben gelesen wie in einem Ort.":1,"ana:anD5":1,"ask:Was weißt du noch von der Abfahrt? Zweiundneunzig.":1,"ask:Ich habe dich gesucht. Am Gleis elf. Im Heim. Bei Ana.":1,"ask:Das war gemein.":1,"ask:(Erzählen.)":1,"ask:Und ich habe gesagt: Schreib „nije se vratio“.":1,"ask:Fünf Tage.":1,"ask:Ich nicht. Morgen. In diesem Jahr.":1,"ask:Und wenn ich nicht mehr kann, sage ich es.":1,"ask:(Zum Käse.)":1,"ask:(Blei gießen.)":1,"ask:(Davor anrufen.)":1,"ask:Wie jedes Jahr?":1,"dlg:h4kv1":1,"k4.g.flurN":1,"ask:(Erzählen. Nur, was war.)":1,"ask:(Warten.)":1,"ask:Sie haben ihn gefunden.":1,"ask:Weil er weiß, wo sie ist.":1,"ask:Ich komme mit.":1,"k4.e.todo":1,"ask:Nada wartet auch.":1,"ask:Woran denkst du?":1,"dlg:epK2":1,"ask:(Den Nachruf schreiben.)":1,"ask:Das Dach in Vratnik.":1,"dlg:epR":1,"ask:Bist du wütend? Auf mich?":1,"dlg:epW":1},"cyc":{"zob:hsBye":1,"jhaus:hbBye":1,"jwohnung:jwPh":1,"ana:tbBye":1,"gleis11:spBye":0,"gleis11:kiBye":0,"bmission:wiBye":1,"barsport:enBye":0,"friedamt:obBye":0,"ana:anD5bye":1},"playMs":324176,"map":{"zob":true,"westend":true,"hbf":true,"giesing":true,"wiesn":true,"heim":true,"bhfviertel":true,"friedhof":true,"moosach":true},"mapKnown":{"giesing":true,"moosach":true,"heim":true},"hints":{},"ended":true}